      "id": "a11e000000000110",
      "type": "function",
      "z": "a11e000000000001",
      "name": "Validate test request",
      "func": "const request = msg.payload && typeof msg.payload === 'object' ? msg.payload : {};\nif (request.action === 'stop') {\n    return [null, { payload: '' }, { payload: { running: true, state: 'cancelling', profile: request.profile || '', duration: Number(request.duration || 0), exitCode: null } }];\n}\nconst profile = request.profile;\nif (profile === 'regression') {\n    const useRp2040 = Boolean(request.rp2040 || request.button || request.reset);\n    const flags = [];\n    if (useRp2040) flags.push('rp2040');\n    if (request.button) flags.push('button');\n    if (request.reset) flags.push('reset');\n    if (request.soak) flags.push('soak');\n    if (request.ota) flags.push(request.otaProfile === 'legacy' ? 'ota-legacy' : 'ota-normal');\n    msg.payload = `regression ${flags.length ? flags.join(',') : 'none'}`;\n    msg.topic = 'start-test';\n    return [msg, null, { payload: { running: true, state: 'starting', profile, duration: 0, exitCode: null, options: flags.join(',') } }];\n}\nconst duration = Math.floor(Number(request.duration));\nconst allowedDurations = [300, 900, 3600, 14400, 28800];\nif (!['host', 'dmx'].includes(profile) || !allowedDurations.includes(duration)) {\n    return [null, null, { payload: { running: false, state: 'error', message: 'Invalid test profile or duration' } }];\n}\nmsg.payload = `${profile} ${duration}`;\nmsg.topic = 'start-test';\nreturn [msg, null, { payload: { running: true, state: 'starting', profile, duration, exitCode: null } }];",
