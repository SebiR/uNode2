    {
      "id": "a11e000000000109",
      "type": "ui-template",
      "z": "a11e000000000001",
      "group": "a11e000000000206",
      "page": "",
      "ui": "",
      "name": "Soak test controls",
      "order": 1,
      "width": 12,
      "height": 0,
      "head": "",
      "format": "<template>\n  <div class=\"unode-soak\">\n    <div class=\"unode-soak__row\">\n      <label>\n        <span>Duration</span>\n        <select v-model.number=\"duration\" :disabled=\"running\">\n          <option :value=\"300\">5 minutes</option>\n          <option :value=\"900\">15 minutes</option>\n          <option :value=\"3600\">1 hour</option>\n          <option :value=\"14400\">4 hours</option>\n          <option :value=\"28800\">8 hours</option>\n        </select>\n      </label>\n      <div class=\"unode-soak__buttons\">\n        <button @click=\"start('host')\" :disabled=\"running\">Start Network Soak</button>\n        <button @click=\"start('dmx')\" :disabled=\"running\">Start DMX HIL Soak</button>\n        <button class=\"unode-soak__cancel\" @click=\"cancel\" v-if=\"running\">Cancel Test</button>\n      </div>\n    </div>\n    <div class=\"unode-soak__status\" :class=\"'is-' + stateName\">\n      <span class=\"unode-soak__dot\"></span>\n      <strong>{{ statusText }}</strong>\n    </div>\n    <p>Only one test job can use the uNode/RP2040 fixture at a time. Progress appears in the pytest log below.</p>\n  </div>\n</template>\n<script>\nexport default {\n  data() {\n    return { duration: 3600 }\n  },\n  computed: {\n    state() {\n      return this.msg && this.msg.payload && typeof this.msg.payload === 'object'\n        ? this.msg.payload\n        : {}\n    },\n    running() {\n      return Boolean(this.state.running)\n    },\n    stateName() {\n      return this.state.state === 'cancelling' ? 'cancelling' : (this.running ? 'running' : (this.state.state || 'idle'))\n    },\n    statusText() {\n      const profile = this.state.profile === 'regression' ? 'Regression test' : (this.state.profile === 'dmx' ? 'DMX HIL soak' : 'Network soak')\n      if (this.state.state === 'cancelling') {\n        return `Cancelling ${profile.toLowerCase()}...`\n      }\n      if (this.running) {\n        return this.state.profile === 'regression' ? 'Regression test running' : `${profile} running (${this.formatDuration(this.state.duration)})`\n      }\n      if (this.state.state === 'passed') {\n        return `Last ${profile} passed`\n      }\n      if (this.state.state === 'failed') {\n        return `Last ${profile} failed (exit ${this.state.exitCode})`\n      }\n      if (this.state.state === 'cancelled') {\n        return `Last ${profile} was cancelled`\n      }\n      if (this.state.state === 'interrupted') {\n        return `Last ${profile} was interrupted`\n      }\n      if (this.state.state === 'error') {\n        return this.state.message || 'Invalid test request'\n      }\n      return 'Test fixture idle'\n    }\n  },\n  methods: {\n    start(profile) {\n      if (this.running) return\n      this.send({\n        topic: 'start-soak',\n        payload: { profile, duration: Number(this.duration) }\n      })\n    },\n    cancel() {\n      if (!this.running) return\n      this.send({ payload: { action: 'stop', profile: this.state.profile, duration: Number(this.state.duration || 0) } })\n    },\n    formatDuration(seconds) {\n      const value = Number(seconds || 0)\n      if (value >= 3600) return `${value / 3600} h`\n      return `${Math.round(value / 60)} min`\n    }\n  }\n}\n</script>\n<style>\n.unode-soak { padding:4px; }\n.unode-soak__row { display:flex; flex-wrap:wrap; gap:16px; align-items:flex-end; justify-content:space-between; }\n.unode-soak label { display:flex; flex-direction:column; gap:6px; min-width:180px; color:rgba(var(--v-theme-on-surface),.7); font-size:.78rem; text-transform:uppercase; letter-spacing:.05em; }\n.unode-soak select { min-height:38px; padding:7px 10px; border:1px solid rgba(var(--v-theme-on-surface),.22); border-radius:5px; color:rgb(var(--v-theme-on-surface)); background:rgb(var(--v-theme-surface)); }\n.unode-soak__buttons { display:flex; flex-wrap:wrap; gap:10px; }\n.unode-soak button { min-height:38px; padding:8px 14px; border:1px solid #315f85; border-radius:5px; background:#315f85; color:#fff; font-weight:700; cursor:pointer; }\n.unode-soak button:nth-child(2) { background:#245f50; border-color:#245f50; }\n.unode-soak button.unode-soak__cancel { background:#a8332c; border-color:#a8332c; }\n.unode-soak button:disabled, .unode-soak select:disabled { opacity:.5; cursor:not-allowed; }\n.unode-soak__status { display:flex; align-items:center; gap:8px; margin-top:14px; padding:10px 12px; border:1px solid rgba(var(--v-theme-on-surface),.16); border-radius:5px; }\n.unode-soak__dot { width:9px; height:9px; border-radius:50%; background:#77838e; }\n.unode-soak__status.is-running .unode-soak__dot { background:#2b83ba; box-shadow:0 0 0 4px rgba(43,131,186,.15); }\n.unode-soak__status.is-passed .unode-soak__dot { background:#178447; }\n.unode-soak__status.is-failed .unode-soak__dot, .unode-soak__status.is-error .unode-soak__dot { background:#b42318; }\n.unode-soak__status.is-interrupted .unode-soak__dot, .unode-soak__status.is-cancelled .unode-soak__dot, .unode-soak__status.is-cancelling .unode-soak__dot { background:#d18b00; }\n.unode-soak p { margin:9px 0 0; color:rgba(var(--v-theme-on-surface),.62); font-size:.8rem; }\n</style>",
