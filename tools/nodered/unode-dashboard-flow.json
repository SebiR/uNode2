      "format": "<template>\n  <div class=\"unode-regression\">\n    <div class=\"unode-regression__options\">\n      <label><input type=\"checkbox\" v-model=\"rp2040\" :disabled=\"running\"> RP2040 DMX / HIL</label>\n      <label><input type=\"checkbox\" v-model=\"button\" :disabled=\"running || !rp2040\"> Button tests (GPIO 8)</label>\n      <label><input type=\"checkbox\" v-model=\"reset\" :disabled=\"running || !rp2040\"> Reset tests (GPIO 7)</label>\n      <label><input type=\"checkbox\" v-model=\"soak\" :disabled=\"running\"> Include 1-minute soak profiles</label>\n      <label><input type=\"checkbox\" v-model=\"ota\" :disabled=\"running\"> Safe OTA reinstall tests</label>\n    </div>\n    <div class=\"unode-regression__actions\">\n      <label>OTA profile\n        <select v-model=\"otaProfile\" :disabled=\"running || !ota\">\n          <option value=\"normal\">Normal hardware</option>\n          <option value=\"legacy\">Legacy hardware</option>\n        </select>\n      </label>\n      <button @click=\"start\" :disabled=\"running\">Start Regression Test</button>\n    </div>\n    <p>Destructive OTA recovery tests are intentionally not available from the dashboard.</p>\n  </div>\n</template>\n<script>\nexport default {\n  data() {\n    return { rp2040: true, button: true, reset: true, soak: false, ota: false, otaProfile: 'normal' }\n  },\n  computed: {\n    state() {\n      return this.msg && this.msg.payload && typeof this.msg.payload === 'object' ? this.msg.payload : {}\n    },\n    running() { return Boolean(this.state.running) }\n  },\n  methods: {\n    start() {\n      if (this.running) return\n      this.send({ payload: { profile: 'regression', rp2040: this.rp2040, button: this.rp2040 && this.button, reset: this.rp2040 && this.reset, soak: this.soak, ota: this.ota, otaProfile: this.otaProfile } })\n    }\n  }\n}\n</script>\n<style>\n.unode-regression { padding:4px; }\n.unode-regression__options { display:grid; grid-template-columns:repeat(auto-fit,minmax(210px,1fr)); gap:10px 16px; }\n.unode-regression__options label { display:flex; align-items:center; gap:8px; min-height:30px; }\n.unode-regression__options input { width:17px; height:17px; accent-color:#315f85; }\n.unode-regression__actions { display:flex; flex-wrap:wrap; align-items:flex-end; justify-content:space-between; gap:14px; margin-top:16px; }\n.unode-regression__actions label { display:flex; flex-direction:column; gap:6px; color:rgba(var(--v-theme-on-surface),.7); font-size:.78rem; text-transform:uppercase; letter-spacing:.05em; }\n.unode-regression select { min-height:38px; min-width:190px; padding:7px 10px; border:1px solid rgba(var(--v-theme-on-surface),.22); border-radius:5px; color:rgb(var(--v-theme-on-surface)); background:rgb(var(--v-theme-surface)); }\n.unode-regression button { min-height:38px; padding:8px 14px; border:1px solid #315f85; border-radius:5px; background:#315f85; color:#fff; font-weight:700; cursor:pointer; }\n.unode-regression button:disabled, .unode-regression select:disabled, .unode-regression input:disabled { opacity:.5; cursor:not-allowed; }\n.unode-regression p { margin:12px 0 0; color:rgba(var(--v-theme-on-surface),.62); font-size:.8rem; }\n</style>",
