      "type": "function",
      "z": "a11e000000000001",
      "name": "Normalize status",
      "func": "const s = msg.payload && typeof msg.payload === 'object' ? msg.payload : {};\nconst online = Number(msg.statusCode) === 200 && !msg.error;\nconst uptimeSeconds = Math.max(0, Math.floor(Number(s.uptime || 0) / 1000));\nconst days = Math.floor(uptimeSeconds / 86400);\nconst hours = Math.floor((uptimeSeconds % 86400) / 3600);\nconst minutes = Math.floor((uptimeSeconds % 3600) / 60);\nconst networkMode = s.wifiConnected ? 'Client' : (s.softAPActive ? 'Access Point' : 'Disconnected');\nconst protocol = Number(s.liveProtocol) === 1 ? 'sACN' : 'Art-Net';\nconst direction = Number(s.direction) === 1 ? 'DMX → Network' : 'Network → DMX';\nmsg.payload = {\n    online,\n    name: online ? (s.name || 'uNode') : 'uNode unavailable',\n    chipId: online ? (s.chipId || 'N/A') : 'N/A',\n    firmware: online ? (s.firmware || 'N/A') : 'N/A',\n    ip: online ? (s.ip || 'N/A') : '2.0.0.1',\n    networkMode: online ? networkMode : 'Disconnected',\n    stations: Number(s.softAPStations || 0),\n    protocol: online ? protocol : 'N/A',\n    direction: online ? direction : 'N/A',\n    universe: online ? Number(s.universe || 0) : 'N/A',\n    uptime: online ? `${days}d ${hours}h ${minutes}m` : 'N/A',\n    heap: online ? `${Math.round(Number(s.freeHeap || 0) / 1024)} KiB` : 'N/A',\n    heapWarning: Boolean(s.heapWarningActive),\n    bootCount: online ? Number(s.bootCount || 0) : 'N/A',\n    resetReason: online ? (s.resetReason || 'N/A') : (msg.error && msg.error.message ? msg.error.message : 'No response'),\n    artnetPackets: online ? Number(s.artnetPackets || 0) : 'N/A',\n    sacnPackets: online ? Number(s.sacnPackets || 0) : 'N/A',\n    dmxFrames: online ? Number(s.dmxFrames || 0) : 'N/A',\n    updated: new Date().toLocaleString('en-GB')\n};\nreturn msg;",
      "outputs": 1,
